<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>EventfulRanges</PackageId>
    <Version>0.0.2</Version>
    <Title>EventfulRanges</Title>
    <Authors>Dmitry Ledentsov</Authors>
    <Copyright>Copyright (c) 2026 Dmitry Ledentsov</Copyright>
    <Description>A CRDT for real-valued ranges: replicas add and remove ranges, exchange operations, and converge to the same set in any arrival order.</Description>
    <PackageTags>crdt;ranges;intervals;convergence;event-sourcing;distributed</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/d-led/eventfulranges.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/d-led/eventfulranges.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
